# Telegram Credentials
# Get your API ID and API HASH from https://my.telegram.org
TG_API_ID=your_telegram_api_id
TG_API_HASH=your_telegram_api_hash

# Telegram MTProto String Session (Generated automatically on first login)
TG_SESSION=

# Telegram Cloud History & Context Configuration
FETCH_TELEGRAM_HISTORY=true
HISTORY_LIMIT=8

# LLM Gateway Configuration (OpenAI-compatible endpoint)
LLM_API_URL=http://localhost:3001/v1/chat/completions
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# LLM Generation Parameters
STANDARD_TEMPERATURE=0.35
RECALL_TEMPERATURE=0.15
MAX_TOKENS=120

# Safety Guardrails & Human Typing Simulation
COOLDOWN_SECONDS=10
TYPING_SPEED_MS=45
MIN_TYPING_DELAY_MS=800
MAX_TYPING_DELAY_MS=2500

# Bot Operation Mode: 'active' (auto-reply) or 'observe' (log only)
BOT_MODE=active
